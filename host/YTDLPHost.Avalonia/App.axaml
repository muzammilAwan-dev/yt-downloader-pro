<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:YTDLPHost.UI"
             x:Class="YTDLPHost.UI.App"
             RequestedThemeVariant="Dark">
  <!--
    Step 4.6b: the design of main's upgrade (host/YTDLPHost/App.xaml) as Avalonia styles.
    Colours are not written here: ThemeResources installs the Dark and Light dictionaries from ThemePalette (Core), the one list both UIs
    share, so every brush below is a {DynamicResource} and follows the theme switch live. Controls keep Fluent's own templates; only
    colours, sizes and corners are overridden. (Fluent has its own "accent" class on Button, so ours is called "cta".)
  -->
  <Application.Resources>
    <CornerRadius x:Key="SurfaceCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

    <!-- Lucide icons (same path data as main's WPF App.xaml), drawn by ui:LucideIcon. -->
    <StreamGeometry x:Key="Icon.Download">M 12 15 V 3 M 21 15 v 4 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 v -4 M 7 10 l 5 5 l 5 -5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pause">M 15 3 H 18 A 1 1 0 0 1 19 4 V 20 A 1 1 0 0 1 18 21 H 15 A 1 1 0 0 1 14 20 V 4 A 1 1 0 0 1 15 3 Z M 6 3 H 9 A 1 1 0 0 1 10 4 V 20 A 1 1 0 0 1 9 21 H 6 A 1 1 0 0 1 5 20 V 4 A 1 1 0 0 1 6 3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Play">M 5 5 a 2 2 0 0 1 3.008 -1.728 l 11.997 6.998 a 2 2 0 0 1 0.003 3.458 l -12 7 A 2 2 0 0 1 5 19 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Stop">M 5 3 H 19 A 2 2 0 0 1 21 5 V 19 A 2 2 0 0 1 19 21 H 5 A 2 2 0 0 1 3 19 V 5 A 2 2 0 0 1 5 3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Cancel">M 18 6 L 6 18 M 6 6 l 12 12</StreamGeometry>
    <StreamGeometry x:Key="Icon.CancelCircle">M 2 12 A 10 10 0 1 1 22 12 A 10 10 0 1 1 2 12 Z M 15 9 l -6 6 M 9 9 l 6 6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M 20 6 L 9 17 l -5 -5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warning">M 21.73 18 l -8 -14 a 2 2 0 0 0 -3.48 0 l -8 14 A 2 2 0 0 0 4 21 h 16 a 2 2 0 0 0 1.73 -3 M 12 9 v 4 M 12 17 h 0.01</StreamGeometry>
    <StreamGeometry x:Key="Icon.Recent">M 2 12 A 10 10 0 1 1 22 12 A 10 10 0 1 1 2 12 Z M 12 6 v 6 l 4 2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Refresh">M 21 12 a 9 9 0 1 1 -9 -9 c 2.52 0 4.93 1 6.74 2.74 L 21 8 M 21 3 v 5 h -5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Sync">M 3 12 a 9 9 0 0 1 9 -9 a 9.75 9.75 0 0 1 6.74 2.74 L 21 8 M 21 3 v 5 h -5 M 21 12 a 9 9 0 0 1 -9 9 a 9.75 9.75 0 0 1 -6.74 -2.74 L 3 16 M 8 16 H 3 v 5</StreamGeometry>
    <StreamGeometry x:Key="Icon.FolderOpen">M 6 14 l 1.5 -2.9 A 2 2 0 0 1 9.24 10 H 20 a 2 2 0 0 1 1.94 2.5 l -1.54 6 a 2 2 0 0 1 -1.95 1.5 H 4 a 2 2 0 0 1 -2 -2 V 5 a 2 2 0 0 1 2 -2 h 3.9 a 2 2 0 0 1 1.69 0.9 l 0.81 1.2 a 2 2 0 0 0 1.67 0.9 H 18 a 2 2 0 0 1 2 2 v 2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Log">M 15 2 H 6 a 2 2 0 0 0 -2 2 v 16 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 V 7 Z M 14 2 v 4 a 2 2 0 0 0 2 2 h 4 M 10 9 H 8 M 16 13 H 8 M 16 17 H 8</StreamGeometry>
    <StreamGeometry x:Key="Icon.Copy">M 10 8 H 20 A 2 2 0 0 1 22 10 V 20 A 2 2 0 0 1 20 22 H 10 A 2 2 0 0 1 8 20 V 10 A 2 2 0 0 1 10 8 Z M 4 16 c -1.1 0 -2 -0.9 -2 -2 V 4 c 0 -1.1 0.9 -2 2 -2 h 10 c 1.1 0 2 0.9 2 2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M 12.22 2 h -0.44 a 2 2 0 0 0 -2 2 v 0.18 a 2 2 0 0 1 -1 1.73 l -0.43 0.25 a 2 2 0 0 1 -2 0 l -0.15 -0.08 a 2 2 0 0 0 -2.73 0.73 l -0.22 0.38 a 2 2 0 0 0 0.73 2.73 l 0.15 0.1 a 2 2 0 0 1 1 1.72 v 0.51 a 2 2 0 0 1 -1 1.74 l -0.15 0.09 a 2 2 0 0 0 -0.73 2.73 l 0.22 0.38 a 2 2 0 0 0 2.73 0.73 l 0.15 -0.08 a 2 2 0 0 1 2 0 l 0.43 0.25 a 2 2 0 0 1 1 1.73 V 20 a 2 2 0 0 0 2 2 h 0.44 a 2 2 0 0 0 2 -2 v -0.18 a 2 2 0 0 1 1 -1.73 l 0.43 -0.25 a 2 2 0 0 1 2 0 l 0.15 0.08 a 2 2 0 0 0 2.73 -0.73 l 0.22 -0.39 a 2 2 0 0 0 -0.73 -2.73 l -0.15 -0.08 a 2 2 0 0 1 -1 -1.74 v -0.5 a 2 2 0 0 1 1 -1.74 l 0.15 -0.09 a 2 2 0 0 0 0.73 -2.73 l -0.22 -0.38 a 2 2 0 0 0 -2.73 -0.73 l -0.15 0.08 a 2 2 0 0 1 -2 0 l -0.43 -0.25 a 2 2 0 0 1 -1 -1.73 V 4 a 2 2 0 0 0 -2 -2 Z M 9 12 A 3 3 0 1 1 15 12 A 3 3 0 1 1 9 12 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Minimize">M 5 12 h 14</StreamGeometry>
    <StreamGeometry x:Key="Icon.Link">M 10 13 a 5 5 0 0 0 7.54 0.54 l 3 -3 a 5 5 0 0 0 -7.07 -7.07 l -1.72 1.71 M 14 11 a 5 5 0 0 0 -7.54 -0.54 l -3 3 a 5 5 0 0 0 7.07 7.07 l 1.71 -1.71</StreamGeometry>
    <StreamGeometry x:Key="Icon.Power">M 12 2 v 10 M 18.4 6.6 a 9 9 0 1 1 -12.77 0.04</StreamGeometry>
    <StreamGeometry x:Key="Icon.Sliders">M 10 5 H 3 M 12 19 H 3 M 14 3 v 4 M 16 17 v 4 M 21 12 h -9 M 21 19 h -5 M 21 5 h -7 M 8 10 v 4 M 8 12 H 3</StreamGeometry>

    <!-- Filter tabs: a RadioButton that looks like a segment of a pill. -->
    <ControlTheme x:Key="FilterTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="Transparent" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,5">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="^:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
    </ControlTheme>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Every window, including the small dialog window of the dialog service. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="avares://YTDLPHost.Avalonia/Assets/Fonts#Inter, Segoe UI Variable, Segoe UI, Roboto, Cantarell, sans-serif" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Motion: colour changes of buttons take 120 ms, so hover and press feel responsive but never snap. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Icon button: 32 x 32, quiet until hovered. "danger" turns red on hover (Cancel). -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>
    <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- Button shapes shared by "queue" (quiet filled), "action" (outlined) and "cta" (the one primary action). -->
    <Style Selector="Button.queue, Button.action, Button.cta">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.queue">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.queue:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.queue:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>

    <Style Selector="Button.action">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>

    <Style Selector="Button.cta">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.cta:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>

    <!-- Text-only buttons: "link" (accent, in the error panel and the toast) and "quiet" (footer). -->
    <Style Selector="Button.link, Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Keyboard focus: a 2 px ring in the text colour (clear on the accent button and on every surface, in both themes). -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- The Limits button of the header: a toggle that looks like a quiet button and turns accent while its panel is open. -->
    <Style Selector="ToggleButton.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>


    <!-- State tile of a card: a rounded square tinted with the state colour, holding the glyph. Shape (the icon) and colour both say what is happening. -->
    <Style Selector="Grid.tile">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Grid.tile > Border.tilebg">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Grid.tile > ui|LucideIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="StrokeWidth" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Data" Value="{StaticResource Icon.Recent}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Grid.tile.downloading > Border.tilebg, Grid.tile.processing > Border.tilebg">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Grid.tile.downloading > ui|LucideIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Download}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Grid.tile.processing > ui|LucideIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Sync}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Grid.tile.paused > Border.tilebg">
      <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
      <Setter Property="Opacity" Value="0.16" />
    </Style>
    <Style Selector="Grid.tile.paused > ui|LucideIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Pause}" />
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Grid.tile.completed > Border.tilebg">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Opacity" Value="0.16" />
    </Style>
    <Style Selector="Grid.tile.completed > ui|LucideIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Check}" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Grid.tile.failed > Border.tilebg">
      <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
    </Style>
    <Style Selector="Grid.tile.failed > ui|LucideIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Warning}" />
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Grid.tile.cancelled > ui|LucideIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Cancel}" />
    </Style>

    <!-- Round icon button: the quiet main action (Pause) of a running card. -->
    <Style Selector="Button.round">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.round:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>

    <!-- Empty state: one restrained tile, three numbered steps. -->
    <Style Selector="Border.emptytile">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <!-- Cards: opaque, a quiet contour; stronger on hover; red when failed. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardContourBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>

    <!-- Secondary row actions (log, cancel, remove) appear when the card is hovered or has keyboard focus; the main action never hides. -->
    <Style Selector="Border.card Button.reveal">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card:pointerover Button.reveal, Border.card:focus-within Button.reveal">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The quality badge makes room for the actions in the same place. -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card:pointerover Border.badge, Border.card:focus-within Border.badge">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.card.failed">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.title.done">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardContourBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardContourBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}" />
    </Style>

    <Style Selector="TextBlock.statusline">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.statusline.failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.statusline.paused">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Download progress bar: 8 px, rounded, accent fill (amber while paused). -->
    <Style Selector="ProgressBar.download">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ProgressFillBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ProgressBar.download.paused">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <!-- Small input controls of the Limits panel. -->
    <Style Selector="ComboBox.small">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style Selector="TextBox.small">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- The download list: cards, no selection or hover tint around them. -->
    <Style Selector="ListBox.downloads">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="22,2,12,14" />
    </Style>
    <Style Selector="ListBox.downloads ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.downloads ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.downloads ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.downloads ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Toast: always in the tree, shown by fading and rising 8 px (exits are as quick as entrances here, and it never blocks clicks while hidden). -->
    <Style Selector="Border.toast">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateY(8px)" />
      <Setter Property="BoxShadow" Value="{DynamicResource ToastShadow}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.toast.shown">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- Footer dot: accent while something is active, muted when idle. No pulsing. -->
    <Style Selector="Ellipse.activity">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Ellipse.activity.busy">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Application.Styles>
</Application>
