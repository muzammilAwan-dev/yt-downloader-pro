<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:YTDLPHost.UI"
        xmlns:native="using:YTDLPHost.Native"
        x:Class="YTDLPHost.UI.BrowserIntegrationWindow"
        x:DataType="ui:BrowserIntegrationViewModel"
        x:CompileBindings="True"
        Title="Browser integration"
        Icon="/Assets/icon.png"
        Width="560" Height="430"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Browser integration" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="The extension talks to this app through a small helper that each browser must be told about." FontSize="12"
                 Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Summary}" FontSize="13" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Browsers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="native:BrowserLinkStatus">
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,100,*">
                  <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,0,12,0" VerticalAlignment="Center"
                          Background="{Binding State, Converter={x:Static ui:LinkStateConverters.DotBrush}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Browser}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Detail}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasRepairLog}" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8">
          <SelectableTextBlock Text="{Binding RepairLog}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Classes="primary" Content="Repair" Command="{Binding RepairCommand}" IsEnabled="{Binding CanRepair}"
              ToolTip.Tip="Link every installed browser to this install again" />
      <Button Classes="action" Content="Close" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
