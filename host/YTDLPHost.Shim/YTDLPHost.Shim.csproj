<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Native Messaging host the browser starts (step 2.4). It only checks WHO started it, finds or starts the app, and copies
    length-prefixed frames between the browser (stdin/stdout) and the app (named pipe). It never reads the JSON.

    Published as a self-contained single file by default (needs no .NET runtime and no extra tools):
        dotnet publish host/YTDLPHost.Shim -c Release -r win-x64 -o shim-publish
    Measured on the owner's PC (2026-11-04): median 109 ms from start to the first reply, so the plan's 150 ms gate is met.
    Native AOT is an option for later (smaller, faster to start) but needs the Visual Studio "Desktop development with C++" tools:
        dotnet publish host/YTDLPHost.Shim -c Release -r win-x64 -p:PublishAot=true -o shim-publish
    Only NativeFrame.cs, NativePipe.cs and the two path files (IAppPaths.cs, PlatformAppPaths.cs; the shim logs to the same folder as the app) are shared with the app (plain stream, pipe and path code). Do NOT reference YTDLPHost.Core: its
    JSON code uses reflection, which Native AOT does not like.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ytdlp-shim</AssemblyName>
    <RootNamespace>YTDLPHost.Shim</RootNamespace>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\YTDLPHost.Core\Native\NativeFrame.cs" Link="Shared\NativeFrame.cs" />
    <Compile Include="..\YTDLPHost.Core\Native\NativePipe.cs" Link="Shared\NativePipe.cs" />
    <Compile Include="..\YTDLPHost.Core\Services\IAppPaths.cs" Link="Shared\IAppPaths.cs" />
    <Compile Include="..\YTDLPHost.Core\Services\PlatformAppPaths.cs" Link="Shared\PlatformAppPaths.cs" />
  </ItemGroup>

</Project>
