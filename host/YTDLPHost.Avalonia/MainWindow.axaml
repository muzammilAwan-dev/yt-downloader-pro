<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YTDLPHost.ViewModels"
        xmlns:svc="using:YTDLPHost.Services"
        xmlns:ui="using:YTDLPHost.UI"
        x:Class="YTDLPHost.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="YT Downloader Pro"
        Icon="/Assets/icon.png"
        Width="980" Height="700"
        MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen">

  <!-- Step 4.6b: the layout of main's upgraded window. All the list logic (tabs, counts, footer, toast) comes from the shared view models. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Header: identity on the left; Limits, hide to tray and settings on the right -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,16,16,14">
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="avares://YTDLPHost.Avalonia/Assets/icon.png" Width="28" Height="28" Margin="0,0,12,0" />
        <TextBlock Text="YT Downloader Pro" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton Name="LimitsToggle" Classes="toolbar" Margin="0,0,8,0"
                      ToolTip.Tip="{Binding Queue.LimitsTooltip}" AutomationProperties.Name="Download limits">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:LucideIcon Data="{StaticResource Icon.Sliders}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Queue.LimitsLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <Button Classes="icon" Command="{Binding MinimizeToTrayCommand}" AutomationProperties.Name="Hide to tray"
                ToolTip.Tip="Hide to the system tray (downloads keep running)">
          <ui:LucideIcon Data="{StaticResource Icon.Minimize}" Width="16" Height="16" />
        </Button>

        <Button Name="SettingsButton" Classes="icon" AutomationProperties.Name="Settings and tools" ToolTip.Tip="Settings and tools">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Tag="update-engine" Header="Update download engine" Click="OnUpdateEngineClick">
                <MenuItem.Icon><ui:LucideIcon Data="{StaticResource Icon.Sync}" Width="16" Height="16" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="-" />
              <MenuItem Header="Appearance" IsEnabled="False" FontSize="11.5" FontWeight="SemiBold" />
              <MenuItem Tag="theme-Dark" Header="Dark" ToggleType="Radio" GroupName="theme" Click="OnThemeClick" />
              <MenuItem Tag="theme-Light" Header="Light" ToggleType="Radio" GroupName="theme" Click="OnThemeClick" />
              <MenuItem Tag="theme-System" Header="Match system" ToggleType="Radio" GroupName="theme" Click="OnThemeClick" />
              <MenuItem Header="-" />
              <MenuItem Header="Browser integration..." Click="OnBrowserIntegrationClick"
                        ToolTip.Tip="See which browsers are linked to this install and repair the link">
                <MenuItem.Icon><ui:LucideIcon Data="{StaticResource Icon.Link}" Width="16" Height="16" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Tag="browser-downloads" Header="Browser downloads: notify only (off)" Click="OnToggleShowWindowClick" />
              <MenuItem Tag="tray-info" Header="No system tray found: closing the window minimises it" IsEnabled="False" IsVisible="False"
                        ToolTip.Tip="This desktop shows no tray icons (on GNOME install the AppIndicator extension). The app keeps running in the task bar; use Exit in this menu to quit." />
              <MenuItem Header="-" />
              <MenuItem Header="Exit YT Downloader Pro" Click="OnExitClick" ToolTip.Tip="Stops the app and any running downloads.">
                <MenuItem.Icon><ui:LucideIcon Data="{StaticResource Icon.Power}" Width="16" Height="16" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="-" />
              <MenuItem Header="Crafted with ⚡ by muzammilAwan-dev" IsEnabled="False" FontSize="11.5" />
            </MenuFlyout>
          </Button.Flyout>
          <ui:LucideIcon Data="{StaticResource Icon.Settings}" Width="18" Height="18" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Filter tabs: only appear once the list is long enough to need them -->
    <Border Grid.Row="1" Classes="panel" HorizontalAlignment="Left" Margin="22,0,22,14" Padding="2"
            IsVisible="{Binding Queue.ShowFilters}">
      <StackPanel Orientation="Horizontal">
        <RadioButton Theme="{StaticResource FilterTab}" GroupName="QueueFilter" Tag="All" Click="OnFilterTabClick"
                     IsChecked="{Binding Queue.Filter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static svc:QueueFilter.All}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="All" />
            <TextBlock Text="{Binding Queue.AllCount}" Classes="muted" FontSize="11.5" FontFeatures="+tnum" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Theme="{StaticResource FilterTab}" GroupName="QueueFilter" Tag="Active" Click="OnFilterTabClick"
                     IsChecked="{Binding Queue.Filter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static svc:QueueFilter.Active}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Active" />
            <TextBlock Text="{Binding Queue.ActiveCount}" Classes="muted" FontSize="11.5" FontFeatures="+tnum" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Theme="{StaticResource FilterTab}" GroupName="QueueFilter" Tag="Done" Click="OnFilterTabClick"
                     IsChecked="{Binding Queue.Filter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static svc:QueueFilter.Done}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Completed" />
            <TextBlock Text="{Binding Queue.DoneCount}" Classes="muted" FontSize="11.5" FontFeatures="+tnum" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Theme="{StaticResource FilterTab}" GroupName="QueueFilter" Tag="Failed" Click="OnFilterTabClick"
                     IsChecked="{Binding Queue.Filter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static svc:QueueFilter.Failed}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Failed" />
            <TextBlock Text="{Binding Queue.FailedCount}" Classes="muted" FontSize="11.5" FontFeatures="+tnum" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <!-- Limits panel (opens under the header): same settings and Save command as before, plus the browser downloads folder -->
    <Border Grid.Row="2" Classes="panel" Margin="22,0,22,14" Padding="18,16" IsVisible="{Binding #LimitsToggle.IsChecked}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
          <TextBlock Text="Downloads at once" FontSize="12" Classes="secondary" Margin="0,0,0,6" />
          <ComboBox Classes="small" IsEditable="True" Width="96" AutomationProperties.Name="Downloads at once"
                    Text="{Binding Settings.MaxConcurrentDownloads, Mode=TwoWay, Converter={x:Static ui:NumberConverters.IntText}}"
                    ToolTip.Tip="How many downloads run at the same time (1-15)">
            <x:String>1</x:String>
            <x:String>2</x:String>
            <x:String>3</x:String>
            <x:String>5</x:String>
            <x:String>10</x:String>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,24,0">
          <TextBlock Text="Speed limit" FontSize="12" Classes="secondary" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal">
            <ComboBox Classes="small" IsEditable="True" Width="110" AutomationProperties.Name="Speed limit"
                      Text="{Binding Settings.SpeedLimit, Mode=TwoWay}"
                      ToolTip.Tip="Use 0 for unlimited, or formats like 500K, 2.5M, 10M">
              <x:String>0</x:String>
              <x:String>500K</x:String>
              <x:String>1M</x:String>
              <x:String>2.5M</x:String>
              <x:String>5M</x:String>
              <x:String>10M</x:String>
            </ComboBox>
            <TextBlock Text="0 = unlimited. Or type 500K, 2.5M, 10M" FontSize="12" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Changes also apply to downloads already running." FontSize="12" Classes="muted"
                   TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,16,6" />

        <Button Grid.Row="0" Grid.Column="3" Classes="cta" Content="Save limits" Command="{Binding SaveSettingsCommand}"
                VerticalAlignment="Bottom" ToolTip.Tip="Save these limits and the folder below" />

        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Browser downloads folder" FontSize="12" Classes="secondary" Margin="0,0,0,6" />
          <TextBox Grid.Row="1" Grid.Column="0" Classes="small" Text="{Binding Settings.DownloadFolder, Mode=TwoWay}"
                   PlaceholderText="Default: Downloads/YTDownloaderPro"
                   AutomationProperties.Name="Browser downloads folder"
                   ToolTip.Tip="Where downloads started from the browser are saved. Leave empty for the default (Downloads/YTDownloaderPro). Press Save limits to keep it." />
          <Button Grid.Row="1" Grid.Column="1" Classes="action" Content="Browse..." Click="OnBrowseDownloadFolderClick" Margin="8,0,0,0" />
        </Grid>
      </Grid>
    </Border>

    <!-- Queue -->
    <Grid Grid.Row="3">
      <!-- Nothing in the queue yet -->
      <StackPanel IsVisible="{Binding !Queue.HasAnyCards}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
        <!-- A soft halo around the icon: the one decorative element of the app, and it says where downloads come from. -->
        <Grid Width="84" Height="84" HorizontalAlignment="Center">
          <Ellipse Fill="{DynamicResource AccentSubtleBrush}" />
          <Ellipse Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="1" Margin="10" />
          <ui:LucideIcon Data="{StaticResource Icon.Download}" StrokeWidth="1.9" Width="30" Height="30" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="No downloads yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6" />
        <TextBlock Text="Click Download on a video in your browser and it will show up here." FontSize="13.5" Classes="secondary"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,18,0,0">
          <Border Classes="chip"><TextBlock Text="YouTube" Classes="muted" FontSize="11.5" /></Border>
          <Border Classes="chip"><TextBlock Text="Instagram" Classes="muted" FontSize="11.5" /></Border>
          <Border Classes="chip"><TextBlock Text="Facebook" Classes="muted" FontSize="11.5" /></Border>
          <Border Classes="chip"><TextBlock Text="and more" Classes="muted" FontSize="11.5" /></Border>
        </StackPanel>
        <TextBlock Text="Downloads keep running when you close this window." FontSize="12" Classes="muted" HorizontalAlignment="Center" Margin="0,22,0,0" />
      </StackPanel>

      <!-- A filter tab has no matches -->
      <TextBlock IsVisible="{Binding Queue.IsFilterEmpty}" Text="{Binding Queue.FilterEmptyText}" Classes="muted" FontSize="13"
                 VerticalAlignment="Center" HorizontalAlignment="Center" />

      <ListBox Classes="downloads" ItemsSource="{Binding Queue.Visible}" IsVisible="{Binding Queue.HasAnyCards}"
               AutomationProperties.Name="Downloads"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DownloadItemViewModel">
            <Border Classes="card" Classes.failed="{Binding HasError}" Classes.active="{Binding IsDownloading}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Play" IsVisible="{Binding IsCompleted}" Click="OnCardPlayClick" />
                  <MenuItem Header="Show in folder" IsVisible="{Binding IsCompleted}" Click="OnCardFolderClick" />
                  <MenuItem Header="Show or hide log" Click="OnCardLogClick" />
                  <MenuItem Header="Retry" IsVisible="{Binding HasError}" Click="OnCardResumeClick" />
                  <MenuItem Header="Resume" IsVisible="{Binding IsPaused}" Click="OnCardResumeClick" />
                  <MenuItem Header="Pause" IsVisible="{Binding CanBePaused}" Click="OnCardPauseClick" />
                  <MenuItem Header="Cancel download (deletes partial files)" IsVisible="{Binding CanBeCancelled}" Click="OnCardCancelClick" />
                  <MenuItem Header="Remove from list (keeps the file)" IsVisible="{Binding CanBeRemoved}" Click="OnCardRemoveClick" />
                </ContextMenu>
              </Border.ContextMenu>

              <Grid ColumnDefinitions="34,*">
                <ui:LucideIcon Grid.Column="0" Classes="glyph"
                               Classes.downloading="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=downloading}"
                               Classes.processing="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=processing}"
                               Classes.paused="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                               Classes.completed="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=completed}"
                               Classes.failed="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failed}"
                               Classes.cancelled="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=cancelled}" />

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                  <!-- Row 0: full-width title and quality; actions never crowd the title -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="title" Classes.done="{Binding IsCompleted}" Text="{Binding DisplayTitle}" ToolTip.Tip="{Binding TitleTooltip}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" VerticalAlignment="Center" />
                    <!-- Right cell: the quality badge at rest; on hover or keyboard focus it gives way to log, cancel and remove, in the same place,
                         so nothing moves and the main action below stays flush with the card edge. -->
                    <Grid Grid.Column="1" Margin="16,-6,-4,-6" VerticalAlignment="Center">
                      <Border Classes="badge" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsVisible="{Binding ResolutionDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ResolutionDisplay}" FontSize="12" FontWeight="SemiBold" Classes="secondary" />
                      </Border>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <!-- The log -->
                        <Button Classes="icon reveal" Width="28" Height="28" Command="{Binding ToggleLogCommand}" ToolTip.Tip="Show or hide the log" AutomationProperties.Name="Show or hide the log">
                          <ui:LucideIcon Data="{StaticResource Icon.Log}" Width="16" Height="16" />
                        </Button>
                        <!-- Cancel: red on hover -->
                        <Button Classes="icon danger reveal" Width="28" Height="28" IsVisible="{Binding CanBeCancelled}" ToolTip.Tip="Cancel download (deletes the partial files)" AutomationProperties.Name="Cancel download"
                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CancelDownloadCommand}" CommandParameter="{Binding}">
                          <ui:LucideIcon Data="{StaticResource Icon.CancelCircle}" Width="15" Height="15" />
                        </Button>
                        <!-- Remove: clears the list entry and keeps the file -->
                        <Button Classes="icon reveal" Width="28" Height="28" IsVisible="{Binding CanBeRemoved}" ToolTip.Tip="Remove from list (keeps the file)" AutomationProperties.Name="Remove from list"
                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveDownloadCommand}" CommandParameter="{Binding}">
                          <ui:LucideIcon Data="{StaticResource Icon.Cancel}" Width="15" Height="15" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <!-- Row 1: status, live metrics, labelled main action -->
                  <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="statusline" Classes.failed="{Binding HasError}" Classes.paused="{Binding IsPaused}"
                               Text="{Binding StatusLine}" ToolTip.Tip="{Binding StatusLine}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <Grid Grid.Column="1" Width="196" ColumnDefinitions="*,92" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding IsTransferMetricsVisible}">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                  IsVisible="{Binding SpeedValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding SpeedValue}" FontSize="20" FontWeight="SemiBold" FontFeatures="+tnum" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding SpeedUnit}" FontSize="12" Classes="muted" Margin="4,0,0,3" VerticalAlignment="Bottom" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding EtaText}" FontSize="12" Classes="muted" FontFeatures="+tnum" Margin="14,0,0,3" VerticalAlignment="Bottom"
                                 IsVisible="{Binding EtaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                      <!-- Completed: Show in folder + Play -->
                      <Button Classes="queue" IsVisible="{Binding IsCompleted}" ToolTip.Tip="Show the file in its folder" AutomationProperties.Name="Show in folder"
                              Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ui:LucideIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                          <TextBlock Text="Show in folder" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon" IsVisible="{Binding IsCompleted}" ToolTip.Tip="Play" AutomationProperties.Name="Play"
                              Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).PlayFileCommand}" CommandParameter="{Binding}">
                        <ui:LucideIcon Data="{StaticResource Icon.Play}" IsSolid="True" Width="15" Height="15" />
                      </Button>

                      <!-- Failed: Retry, the one primary action -->
                      <Button Classes="cta" IsVisible="{Binding HasError}" ToolTip.Tip="Try this download again" AutomationProperties.Name="Retry"
                              Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ResumeDownloadCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <ui:LucideIcon Data="{StaticResource Icon.Refresh}" Width="15" Height="15" />
                          <TextBlock Text="Retry" />
                        </StackPanel>
                      </Button>

                      <!-- Paused: Resume -->
                      <Button Classes="cta" IsVisible="{Binding IsPaused}" ToolTip.Tip="Continue this download" AutomationProperties.Name="Resume"
                              Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ResumeDownloadCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <ui:LucideIcon Data="{StaticResource Icon.Play}" IsSolid="True" Width="14" Height="14" />
                          <TextBlock Text="Resume" />
                        </StackPanel>
                      </Button>

                      <Button Classes="queue" IsVisible="{Binding CanBePaused}" ToolTip.Tip="Pause this download" AutomationProperties.Name="Pause"
                              Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).PauseDownloadCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ui:LucideIcon Data="{StaticResource Icon.Pause}" IsSolid="True" Width="15" Height="15" />
                          <TextBlock Text="Pause" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- Row 2: progress (only while downloading or paused) -->
                  <ProgressBar Grid.Row="2" Classes="download" Classes.paused="{Binding IsPaused}" Margin="0,10,0,0" Maximum="100"
                               AutomationProperties.Name="{Binding ProgressAutomationName}" Focusable="False"
                               Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                               IsVisible="{Binding IsProgressVisible}" />

                  <!-- Row 3: failure explanation. The title is in the status line; here: what to do, plus the raw details on demand -->
                  <Border Grid.Row="3" Background="{DynamicResource ErrorSoftBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,8" Margin="0,8,0,0"
                          IsVisible="{Binding HasError}">
                    <StackPanel>
                      <TextBlock Text="{Binding ErrorHint}" FontSize="12.5" TextWrapping="Wrap"
                                 IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="16">
                        <Button Classes="link" Command="{Binding ToggleErrorDetailsCommand}" AutomationProperties.Name="{Binding ErrorDetailsToggleText}">
                          <TextBlock Text="{Binding ErrorDetailsToggleText}" />
                        </Button>
                        <Button Classes="link" Command="{Binding CopyErrorCommand}" ToolTip.Tip="Copy the full error text" AutomationProperties.Name="Copy error">
                          <TextBlock Text="Copy error" />
                        </Button>
                      </StackPanel>
                      <!-- Selectable text: the raw yt-dlp message can be selected and copied -->
                      <SelectableTextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5"
                                           FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" Foreground="{DynamicResource ErrorBrush}"
                                           AutomationProperties.Name="Technical error details" IsVisible="{Binding IsErrorDetailsVisible}" />
                    </StackPanel>
                  </Border>

                  <!-- Row 4: log panel -->
                  <Border Grid.Row="4" Background="{DynamicResource LogBackgroundBrush}" BorderBrush="{DynamicResource CardContourBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,10,0,0" Padding="12" IsVisible="{Binding IsLogVisible}">
                    <Grid>
                      <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock Text="{Binding Task.UiLogText, Mode=OneWay}" Classes="secondary" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,36,0"
                                             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" AutomationProperties.Name="Download log" />
                      </ScrollViewer>
                      <Button Classes="icon" Command="{Binding CopyLogCommand}" ToolTip.Tip="Copy the full log" AutomationProperties.Name="Copy log"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0" Width="28" Height="28">
                        <ui:LucideIcon Data="{StaticResource Icon.Copy}" Width="16" Height="16" />
                      </Button>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Toast: replaces message boxes, which cannot follow the theme -->
      <Border Classes="toast" Classes.shown="{Binding Toast.IsVisible}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,18" Padding="16,11"
              Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
              CornerRadius="{StaticResource SurfaceCornerRadius}">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding Toast.Message}" FontSize="12.5" MaxWidth="520" TextWrapping="Wrap" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Classes="link" Content="{Binding Toast.ActionLabel}" IsVisible="{Binding Toast.HasAction}" Click="OnToastActionClick" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Footer: queue status on the left; "Clear finished" and total speed on the right -->
    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Ellipse Classes="activity" Classes.busy="{Binding Queue.IsBusy}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Queue.FooterText}" FontSize="12" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <Button Classes="quiet" Content="Clear finished" Command="{Binding ClearFinishedCommand}" IsVisible="{Binding Queue.CanClearFinished}"
                  ToolTip.Tip="Remove completed and cancelled downloads from this list (files stay on disk)" />
          <TextBlock Text="{Binding Queue.FooterSpeedText}" IsVisible="{Binding Queue.HasFooterSpeed}" FontSize="12" FontWeight="SemiBold" FontFeatures="+tnum"
                     VerticalAlignment="Center" ToolTip.Tip="Total download speed" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
